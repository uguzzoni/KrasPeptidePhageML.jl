# Where the data files live.
#
# All three ship in `data/`, so this file is optional — `data_path` falls back to
# the bundled copies. Copy it to `config/paths.toml` (git-ignored) only to point
# the package at data kept elsewhere. Relative paths resolve against the
# repository root; every key can also be overridden by an environment variable or
# by a function argument — see `src/paths.jl` for the precedence rules.

# Counts table: `sequence` + one integer column per tree node. Column 1 after
# `sequence` is the root (initial library), the rest are the 32 rounds in the
# row order of the sample table.
#   env: KRAS_COUNTS_CSV
counts_csv = "data/lung_counts.csv"

# Sample table: one row per round, joined to the counts table on `counts_column`.
#   env: KRAS_SAMPLES_CSV
samples_csv = "data/lung_samples.csv"

# A fitted model (.jld2 storing the model under the key "model").
#   env: KRAS_REFERENCE_MODEL
reference_model = "data/model_nn_2l.jld2"
